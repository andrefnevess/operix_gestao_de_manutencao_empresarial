# Copie para .env e ajuste. Nunca versione o arquivo .env.

# "memoria" roda sem banco, com dados de exemplo. Qualquer outro valor usa o PostgreSQL via Prisma.
PERSISTENCIA=memoria

# Conexão do Prisma com o PostgreSQL (usada quando PERSISTENCIA não é "memoria").
DATABASE_URL=postgresql://operix:operix@localhost:5432/operix

# Segredo para assinar os tokens de login. Obrigatório em produção.
JWT_SECRET=troque-este-valor

# Senha dos usuários de exemplo (admin@, gestor@, tecnico@ e solicitante@operix.local). Somente desenvolvimento.
SENHA_EXEMPLO=operix-dev

PORT=3000
CORS_ORIGIN=http://localhost:3001
