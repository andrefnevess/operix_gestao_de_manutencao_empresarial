# Imagem do front-end (Next.js em modo standalone). Contexto de build: pasta frontend/.
FROM node:20-alpine AS build
WORKDIR /app
# Endereço da API durante o build. Em execução, vale a variável API_URL do container (veja docker-compose.yml).
ARG API_URL=http://api:3000
ENV API_URL=$API_URL
ENV NEXT_TELEMETRY_DISABLED=1
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public
EXPOSE 3000
CMD ["node", "server.js"]
